@page
@model StudentMathTest.Api.Pages.Students.ExamsModel
@{ ViewData["Title"] = $"Exams — Student {Model.StudentId}"; }

<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Students/Index">Students</a></li>
        <li class="breadcrumb-item active">Student #@Model.StudentId</li>
    </ol>
</nav>

<h2 class="mb-4">Exam History — Student #@Model.StudentId</h2>

<div class="card shadow-sm">
    <div class="card-header fw-semibold d-flex justify-content-between">
        <span>All Exams</span>
        <span class="badge bg-secondary">@Model.Exams.Count() exam(s)</span>
    </div>
    <div class="card-body p-0">
        @if (!Model.Exams.Any())
        {
            <p class="text-muted p-3 mb-0">No exams found for student #@Model.StudentId.</p>
        }
        else
        {
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr><th>Exam ID</th><th>XML Exam ID</th><th>Submitted</th><th>Tasks</th><th>Correct</th><th>Score</th><th>Detail</th></tr>
                </thead>
                <tbody>
                    @foreach (var exam in Model.Exams)
                    {
                        var scoreClass = exam.Score >= 80 ? "bg-success" : exam.Score >= 50 ? "bg-warning text-dark" : "bg-danger";
                        <tr>
                            <td class="text-muted">#@exam.ExamId</td>
                            <td>@exam.XmlExamId</td>
                            <td class="text-muted">@exam.SubmittedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@exam.TotalTasks</td>
                            <td>@exam.CorrectTasks / @exam.TotalTasks</td>
                            <td><span class="badge @scoreClass fs-6">@exam.Score%</span></td>
                            <td><a asp-page="/Students/ExamDetail" asp-route-examId="@exam.ExamId" class="btn btn-sm btn-outline-primary">View Tasks</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
