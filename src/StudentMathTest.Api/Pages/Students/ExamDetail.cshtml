@page
@model StudentMathTest.Api.Pages.Students.ExamDetailModel
@{
    ViewData["Title"] = $"Exam Detail #{Model.ExamId}";
    var exam = Model.Exam!;
    var scorePct = exam.TotalTasks == 0 ? 0 : Math.Round((double)exam.CorrectTasks / exam.TotalTasks * 100, 1);
    var scoreClass = scorePct >= 80 ? "bg-success" : scorePct >= 50 ? "bg-warning text-dark" : "bg-danger";
}

<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Students/Index">Students</a></li>
        <li class="breadcrumb-item"><a asp-page="/Students/Exams" asp-route-studentId="@exam.StudentId">Student #@exam.StudentId</a></li>
        <li class="breadcrumb-item active">Exam #@exam.XmlExamId</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-2">
    <div>
        <h2 class="mb-1">Exam #@exam.XmlExamId — Student #@exam.StudentId</h2>
        <p class="text-muted mb-0">Submitted @exam.SubmittedAt.ToString("yyyy-MM-dd HH:mm UTC") &nbsp;|&nbsp; Teacher #@exam.TeacherId</p>
    </div>
    <div class="text-end">
        <span class="badge @scoreClass fs-5 px-3 py-2">@scorePct%</span>
        <div class="text-muted mt-1 small">@exam.CorrectTasks / @exam.TotalTasks correct</div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header fw-semibold">Task Breakdown</div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr><th>#</th><th>Expression</th><th>Student Answer</th><th>Correct Answer</th><th>Result</th></tr>
            </thead>
            <tbody>
                @foreach (var task in exam.Tasks)
                {
                    <tr class="@(task.IsCorrect ? "table-success" : "table-danger")">
                        <td class="text-muted">@task.TaskId</td>
                        <td><code>@task.Expression</code></td>
                        <td>@task.StudentAnswer</td>
                        <td><strong>@task.CorrectAnswer</strong></td>
                        <td>
                            @if (task.IsCorrect)
                            {
                                <span class="badge badge-correct">Correct</span>
                            }
                            else
                            {
                                <span class="badge badge-wrong">Wrong</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3">
    <a asp-page="/Students/Exams" asp-route-studentId="@exam.StudentId" class="btn btn-outline-secondary">&larr; Back to Exams</a>
</div>
